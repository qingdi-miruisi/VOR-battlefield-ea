\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Friedman mean ranks over the nine LSMOP instances (M=3, D=300), 12 algorithms = \textbf  {EDDV8 (ours, grafted)} + eight traditional baselines (NSGA-II/III, MOEAD, SPEA2, SMS-EMOA, RVEA, AGE-MOEA, MOGWO) + three 2026 state-of-the-art methods (FDSEA, GDVTSF, MOEA-IB); 30 independent seeds per cell. Lower is better; bold = best. The 2026 SOTA methods are the strongest on this family; EDDV8 ties the original EDD at rank 4--5 (IGD 5th / HV 4th combined), ahead of all eight traditional baselines but behind the SOTA trio.}}{14}{table.1}\protected@file@percent }
\newlabel{tab:lsmop_ranks}{{1}{14}{Friedman mean ranks over the nine LSMOP instances (M=3, D=300), 12 algorithms = \textbf {EDDV8 (ours, grafted)} + eight traditional baselines (NSGA-II/III, MOEAD, SPEA2, SMS-EMOA, RVEA, AGE-MOEA, MOGWO) + three 2026 state-of-the-art methods (FDSEA, GDVTSF, MOEA-IB); 30 independent seeds per cell. Lower is better; bold = best. The 2026 SOTA methods are the strongest on this family; EDDV8 ties the original EDD at rank 4--5 (IGD 5th / HV 4th combined), ahead of all eight traditional baselines but behind the SOTA trio}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}The result is bimodal, and we report it as such}{14}{subsection.5.2}\protected@file@percent }
\newlabel{sec:bimodal}{{5.2}{14}{The result is bimodal, and we report it as such}{subsection.5.2}{}}
\@writefile{toc}{\contentsline {paragraph}{(a) On five instances the baselines collapse completely --- EDD does not.}{14}{section*.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Per-problem median IGD (30 seeds, lower = better) for the 12-algorithm LSMOP comparison. \textbf  {EDDV8} (the grafted variant) replaces the original EDD. Bold = per-column best. EDDV8 ties the original EDD on every instance (same mechanism, same seed stream); the 2026 SOTA trio (FDSEA, GDVTSF, MOEA-IB) leads on the converged instances.}}{15}{table.2}\protected@file@percent }
\newlabel{tab:lsmop_igd}{{2}{15}{Per-problem median IGD (30 seeds, lower = better) for the 12-algorithm LSMOP comparison. \textbf {EDDV8} (the grafted variant) replaces the original EDD. Bold = per-column best. EDDV8 ties the original EDD on every instance (same mechanism, same seed stream); the 2026 SOTA trio (FDSEA, GDVTSF, MOEA-IB) leads on the converged instances}{table.2}{}}
\@writefile{toc}{\contentsline {paragraph}{A necessary precision about what ``converges'' means here.}{15}{section*.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Per-problem median hypervolume (30 seeds, larger = better; reference point = $1.1\times $ max of the true front). Bold = per-column best. \textbf  {EDDV8} (the grafted variant) replaces the original EDD. On LSMOP6 and LSMOP7 the traditional field and EDDV8 all attain $\mathrm  {HV}=0$ (total convergence collapse); only FDSEA reaches non-zero HV on LSMOP6. The 2026 SOTA trio attains non-zero HV on strictly more instances than EDDV8.}}{16}{table.3}\protected@file@percent }
\newlabel{tab:lsmop_hv}{{3}{16}{Per-problem median hypervolume (30 seeds, larger = better; reference point = $1.1\times $ max of the true front). Bold = per-column best. \textbf {EDDV8} (the grafted variant) replaces the original EDD. On LSMOP6 and LSMOP7 the traditional field and EDDV8 all attain $\mathrm {HV}=0$ (total convergence collapse); only FDSEA reaches non-zero HV on LSMOP6. The 2026 SOTA trio attains non-zero HV on strictly more instances than EDDV8}{table.3}{}}
\@writefile{toc}{\contentsline {paragraph}{(b) On three instances where every algorithm converges, EDD is behind.}{16}{section*.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Component ablation of EDD (5 seeds per cell, $N=100$, $G=200$). \texttt  {full} reproduces the released EDD v12 exactly. \texttt  {no-EED} forces the APD/SMS path at $D\ge 100$; \texttt  {no-DSG} keeps EED selection but replaces the DSG offspring operator with SBX; \texttt  {no-polish} disables the polish-HV step. Median IGD, with the factor relative to \texttt  {full} in parentheses. EED is individually necessary on the collapse instances and individually \emph  {harmful} on the converged instance (LSMOP2).}}{17}{table.4}\protected@file@percent }
\newlabel{tab:ablation}{{4}{17}{Component ablation of EDD (5 seeds per cell, $N=100$, $G=200$). \texttt {full} reproduces the released EDD v12 exactly. \texttt {no-EED} forces the APD/SMS path at $D\ge 100$; \texttt {no-DSG} keeps EED selection but replaces the DSG offspring operator with SBX; \texttt {no-polish} disables the polish-HV step. Median IGD, with the factor relative to \texttt {full} in parentheses. EED is individually necessary on the collapse instances and individually \emph {harmful} on the converged instance (LSMOP2)}{table.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Component ablation}{17}{subsection.5.3}\protected@file@percent }
\newlabel{sec:ablation}{{5.3}{17}{Component ablation}{subsection.5.3}{}}
\@writefile{toc}{\contentsline {paragraph}{(a) On the collapse instances, EED and DSG are each individually necessary.}{17}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(b) On the converged multimodal instance, EED is actively harmful.}{17}{section*.5}\protected@file@percent }
\citation{hcea2026}
\@writefile{toc}{\contentsline {paragraph}{(c) polish-HV shows no measurable benefit on this test set.}{18}{section*.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Convergence behaviour}{18}{subsection.5.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Pareto front comparison}{18}{subsection.5.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Convergence behaviour: median IGD at three budget levels, obtained by re-running each algorithm at $G\in \{25,50,100,150,200\}$ with 3 seeds per point under an identical protocol. On LSMOP6, EDD reaches its final value at $G=25$; on LSMOP2, EDD's IGD \emph  {degrades} monotonically over the budget, the only degrading trajectory in the study.}}{19}{table.5}\protected@file@percent }
\newlabel{tab:conv}{{5}{19}{Convergence behaviour: median IGD at three budget levels, obtained by re-running each algorithm at $G\in \{25,50,100,150,200\}$ with 3 seeds per point under an identical protocol. On LSMOP6, EDD reaches its final value at $G=25$; on LSMOP2, EDD's IGD \emph {degrades} monotonically over the budget, the only degrading trajectory in the study}{table.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Discussion}{19}{section.6}\protected@file@percent }
\newlabel{sec:discussion}{{6}{19}{Discussion}{section.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}The mechanism behind the bimodal result}{19}{subsection.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces IGD convergence trajectory on LSMOP6 (3 seeds per budget point). EDD reaches its final IGD of $1.629$ already at $G=25$ and does not improve further; MOGWO needs the full 200 generations; every other algorithm remains two to three orders of magnitude away at the full budget. EDD's advantage on the collapse instances is therefore a \emph  {speed} advantage as much as a quality advantage.}}{20}{figure.1}\protected@file@percent }
\newlabel{fig:conv_lsmop6}{{1}{20}{IGD convergence trajectory on LSMOP6 (3 seeds per budget point). EDD reaches its final IGD of $1.629$ already at $G=25$ and does not improve further; MOGWO needs the full 200 generations; every other algorithm remains two to three orders of magnitude away at the full budget. EDD's advantage on the collapse instances is therefore a \emph {speed} advantage as much as a quality advantage}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Why the combined rank ranks EDD 4th, not 1st}{20}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces IGD convergence trajectory on LSMOP2 (3 seeds per budget point). EDD's IGD degrades monotonically from $0.3321$ at $G=25$ to $0.4249$ at $G=200$ --- the only degrading trajectory in the study --- while MOEAD and RVEA improve slightly and stay near $0.09$. This is the trajectory-level signature of the ablation result (b): the EED path does not merely fail to help on LSMOP2, it actively pulls the population off the front as generations accumulate.}}{21}{figure.2}\protected@file@percent }
\newlabel{fig:conv_lsmop2}{{2}{21}{IGD convergence trajectory on LSMOP2 (3 seeds per budget point). EDD's IGD degrades monotonically from $0.3321$ at $G=25$ to $0.4249$ at $G=200$ --- the only degrading trajectory in the study --- while MOEAD and RVEA improve slightly and stay near $0.09$. This is the trajectory-level signature of the ablation result (b): the EED path does not merely fail to help on LSMOP2, it actively pulls the population off the front as generations accumulate}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}The CF/MW result: PPS collapse reduced, not eliminated}{21}{subsection.6.3}\protected@file@percent }
\newlabel{sec:cfmw}{{6.3}{21}{The CF/MW result: PPS collapse reduced, not eliminated}{subsection.6.3}{}}
\citation{hcea2026}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Pareto fronts on LSMOP6 ($M=3$, $D=300$, seed 1). One panel per algorithm with per-panel axis limits and the algorithm's IGD annotated; the sixth panel repeats all five algorithms on shared axes. Per-panel scaling is deliberate: IGD on this instance spans a factor of $\sim $2\,200 ($1.63$ for EDD versus $3\,613$ for HCEAV4), so a shared linear axis would reduce EDD's front to a single invisible point. The true front is the unit sphere's positive orthant (black dots). Note that EDD's front mixes a converged subset with divergent outliers reaching $f_2 \approx 6\times 10^5$ --- see the precision note in Section~\ref {sec:bimodal}.}}{22}{figure.3}\protected@file@percent }
\newlabel{fig:pf}{{3}{22}{Pareto fronts on LSMOP6 ($M=3$, $D=300$, seed 1). One panel per algorithm with per-panel axis limits and the algorithm's IGD annotated; the sixth panel repeats all five algorithms on shared axes. Per-panel scaling is deliberate: IGD on this instance spans a factor of $\sim $2\,200 ($1.63$ for EDD versus $3\,613$ for HCEAV4), so a shared linear axis would reduce EDD's front to a single invisible point. The true front is the unit sphere's positive orthant (black dots). Note that EDD's front mixes a converged subset with divergent outliers reaching $f_2 \approx 6\times 10^5$ --- see the precision note in Section~\ref {sec:bimodal}}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Pareto fronts on LSMOP2, the instance on which EDD ranks last on IGD: here the traditional baselines converge (MOEAD IGD $0.091$, RVEA $0.093$, NSGA-II $0.105$) and EDD does not ($0.423$). The 2026 SOTA methods (FDSEA, GDVTSF, MOEA-IB) resolve the front more sharply than EDD on this converged instance, consistent with the failure-boundary analysis in Section~\ref {sec:cfmw}.}}{23}{figure.4}\protected@file@percent }
\newlabel{fig:pf_lsmop2}{{4}{23}{Pareto fronts on LSMOP2, the instance on which EDD ranks last on IGD: here the traditional baselines converge (MOEAD IGD $0.091$, RVEA $0.093$, NSGA-II $0.105$) and EDD does not ($0.423$). The 2026 SOTA methods (FDSEA, GDVTSF, MOEA-IB) resolve the front more sharply than EDD on this converged instance, consistent with the failure-boundary analysis in Section~\ref {sec:cfmw}}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Negative result on polish-HV}{23}{subsection.6.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Honest limitations: three residual boundaries}{23}{subsection.6.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Pareto fronts on DTLZ2-300D-M3, the cross-validation instance: EDD is the only algorithm whose front reaches the true front (IGD $0.738$ against $2.062$ for NSGA-II, $2.567$ for RVEA, $4.612$ for MOEAD and $7.243$ for HCEAV4). This shows the mechanism is not specific to the LSMOP composition structure; but DTLZ2-300D is also the instance on which most algorithms fail outright, so we do not over-weight it as independent evidence.}}{24}{figure.5}\protected@file@percent }
\newlabel{fig:pf_dtlz2}{{5}{24}{Pareto fronts on DTLZ2-300D-M3, the cross-validation instance: EDD is the only algorithm whose front reaches the true front (IGD $0.738$ against $2.062$ for NSGA-II, $2.567$ for RVEA, $4.612$ for MOEAD and $7.243$ for HCEAV4). This shows the mechanism is not specific to the LSMOP composition structure; but DTLZ2-300D is also the instance on which most algorithms fail outright, so we do not over-weight it as independent evidence}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Component ablation (median IGD, $\log _{10}$ scale) on LSMOP6 (collapse instance), LSMOP9 (collapse instance) and LSMOP2 (converged instance). Removing EED or DSG collapses the collapse instances by two to three orders of magnitude ($2\,892\times $ on LSMOP6, $27.5\times $ on LSMOP9), while removing EED \emph  {improves} LSMOP2 by $4.1\times $. The polish-HV variant shows no measurable effect ($1.00\times $ change) on the collapse instances. This is the mechanistic evidence for the bimodal result in Section~\ref {sec:bimodal} and for the PPS-collapse failure boundary in Section~\ref {sec:cfmw}.}}{25}{figure.6}\protected@file@percent }
\newlabel{fig:ablation}{{6}{25}{Component ablation (median IGD, $\log _{10}$ scale) on LSMOP6 (collapse instance), LSMOP9 (collapse instance) and LSMOP2 (converged instance). Removing EED or DSG collapses the collapse instances by two to three orders of magnitude ($2\,892\times $ on LSMOP6, $27.5\times $ on LSMOP9), while removing EED \emph {improves} LSMOP2 by $4.1\times $. The polish-HV variant shows no measurable effect ($1.00\times $ change) on the collapse instances. This is the mechanistic evidence for the bimodal result in Section~\ref {sec:bimodal} and for the PPS-collapse failure boundary in Section~\ref {sec:cfmw}}{figure.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Conclusion}{25}{section.7}\protected@file@percent }
\newlabel{sec:conclusion}{{7}{25}{Conclusion}{section.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces EDDV8 (grafted, constraint-aware NSGA-2 selection) versus the original EDD\_cf and three 2026 SOTA algorithms on the official constrained CF/MW family (CF1--10, MW1--14; 30 seeds per cell). Panel (a) reports the 5-algorithm Friedman IGD mean ranks. Panel (b) reports the median final non-dominated-set size (PPS) on a representative subset. \textbf  {EDDV8 ranks 4th of 5 on the CF/MW aggregate ($2.83$), improving over the original EDD\_cf ($3.75$) but remaining behind the three SOTA methods.} The PPS collapse that was the original EDD\_cf's defining weakness is \emph  {reduced} but not eliminated: EDDV8's median PPS on the MW family rises from $\approx 1$ (original EDD\_cf) to $\approx 24$, but persists at PPS $\le 10$ on eleven of the twenty-four instances, including six where it degenerates to a single point.}}{26}{table.6}\protected@file@percent }
\newlabel{tab:cfmw}{{6}{26}{EDDV8 (grafted, constraint-aware NSGA-2 selection) versus the original EDD\_cf and three 2026 SOTA algorithms on the official constrained CF/MW family (CF1--10, MW1--14; 30 seeds per cell). Panel (a) reports the 5-algorithm Friedman IGD mean ranks. Panel (b) reports the median final non-dominated-set size (PPS) on a representative subset. \textbf {EDDV8 ranks 4th of 5 on the CF/MW aggregate ($2.83$), improving over the original EDD\_cf ($3.75$) but remaining behind the three SOTA methods.} The PPS collapse that was the original EDD\_cf's defining weakness is \emph {reduced} but not eliminated: EDDV8's median PPS on the MW family rises from $\approx 1$ (original EDD\_cf) to $\approx 24$, but persists at PPS $\le 10$ on eleven of the twenty-four instances, including six where it degenerates to a single point}{table.6}{}}
